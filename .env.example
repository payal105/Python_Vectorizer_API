# Copy to .env and edit. All settings are optional; defaults shown.

VECTOR_ENVIRONMENT=development
VECTOR_DEBUG=false

# --- Authentication ----------------------------------------------------------
# Comma-separated "id:secret" pairs. Clients authenticate with HTTP Basic
# (id as username, secret as password), or "X-Api-Key: id:secret".
# Leave VECTOR_API_KEYS empty AND set VECTOR_REQUIRE_AUTH=false for open access.
VECTOR_REQUIRE_AUTH=true
VECTOR_API_KEYS=demo_id:demo_secret

# --- Limits ------------------------------------------------------------------
VECTOR_MAX_UPLOAD_BYTES=33554432
VECTOR_MAX_INPUT_PIXELS=30000000
VECTOR_MAX_OUTPUT_PIXELS=33000000
VECTOR_JOB_TIMEOUT_SECONDS=120

# --- Remote image fetching (image.url) ---------------------------------------
VECTOR_ALLOW_URL_FETCH=true
VECTOR_ALLOW_PRIVATE_NETWORK_FETCH=false
VECTOR_FETCH_TIMEOUT_SECONDS=20

# --- Throughput --------------------------------------------------------------
# Concurrent tracing jobs. Defaults to CPU count when 0.
VECTOR_MAX_CONCURRENT_JOBS=0
VECTOR_RATE_LIMIT_PER_MINUTE=60

# --- Credits -----------------------------------------------------------------
VECTOR_CREDITS_ENABLED=true
VECTOR_DEFAULT_CREDIT_BALANCE=1000
